{
  "name": "@ithie/use-form",
  "version": "0.0.1",
  "description": "A simple composable for vue3 to handle forms and the according data",
  "type": "module",
  "main": "./dist/use-form.umd.js",
  "module": "./dist/use-form.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/use-form.js",
      "require": "./dist/use-form.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "check:duplication": "jscpd",
    "lint": "eslint . --ext .vue,.js,.ts",
    "test": "vitest -c vitest.config.ts",
    "test:coverage": "vitest run --coverage -c vitest.config.ts",
    "quality:gate": "npm run lint && npm run test:coverage && npm run check:duplication"
  },
  "keywords": [
    "vue",
    "vue3",
    "composable",
    "form",
    "useForm"
  ],
  "author": "ithie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ithie/use-form.git"
  },
  "bugs": {
    "url": "https://github.com/ithie/use-form/issues"
  },
  "homepage": "https://github.com/ithie/use-form#readme",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitest/coverage-v8": "^4.0.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.1",
    "jscpd": "^4.0.5",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.46.3",
    "vite": "^5.3.1",
    "vitest": "^4.0.6",
    "vue": "^3.4.30",
    "vue-tsc": "^2.0.24"
  }
}
